# Copy to .env and fill in. Never commit the real .env file.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/verdict_beach
CLIENT_URL=http://localhost:5173

# REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Gmail SMTP. Use a Google App Password (requires 2-Step Verification), not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your_16_char_app_password
# Where internal enquiry alerts are sent (the team's official inbox).
NOTIFICATION_EMAIL=official-inbox@yourdomain.com
